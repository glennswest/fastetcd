# CI image: assumes the `fastetcd` binary is already at the build
# context root (downloaded as an artifact from the build-linux-binary
# job). Skips the build stage for faster CI image production.
FROM gcr.io/distroless/cc-debian12
COPY ./fastetcd /usr/local/bin/fastetcd
EXPOSE 2379 2380
VOLUME ["/var/lib/fastetcd"]
USER nonroot
ENTRYPOINT ["/usr/local/bin/fastetcd"]
CMD ["--data-dir=/var/lib/fastetcd"]
